DLGTEMPLATE DLG_GameOptions 
BEGIN
	DIALOG "Ribble - Options view", DLG_GameOptions, 128, 64, 163, 121, WS_VISIBLE, FCF_SYSMENU | FCF_TITLEBAR
	PRESPARAMS PP_FONTNAMESIZE "8.Helv"
	BEGIN
		CONTROL "~Performance tuning", -1, 6, 23, 151, 95, WC_STATIC, SS_GROUPBOX | DT_LEFT | DT_TOP | DT_MNEMONIC | WS_VISIBLE
		CONTROL "Re~fresh every", -1, 14, 92, 48, 8, WC_STATIC, SS_TEXT | DT_LEFT | DT_TOP | DT_MNEMONIC | WS_VISIBLE
		CONTROL "", DID_RefreshRate, 63, 91, 41, 12, WC_SPINBUTTON, SPBS_MASTER | SPBS_NUMERICONLY | SPBS_JUSTLEFT | SPBS_FASTSPIN | WS_VISIBLE | WS_GROUP | WS_TABSTOP
		PRESPARAMS PP_FONTNAMESIZE "10.Helv"
		CONTROL "milliseconds", -1, 109, 92, 42, 8, WC_STATIC, SS_TEXT | DT_LEFT | DT_TOP | DT_MNEMONIC | WS_VISIBLE
		CONTROL "Playi~ng area", -1, 15, 30, 132, 53, WC_STATIC, SS_GROUPBOX | DT_LEFT | DT_TOP | DT_MNEMONIC | WS_VISIBLE
		CONTROL "~Visible width/height", -1, 35, 56, 41, 15, WC_STATIC, SS_TEXT | DT_LEFT | DT_TOP | DT_WORDBREAK | DT_MNEMONIC | WS_VISIBLE
		CONTROL "", DID_VisibleSize, 81, 57, 42, 12, WC_SPINBUTTON, SPBS_MASTER | SPBS_READONLY | SPBS_JUSTLEFT | WS_VISIBLE | WS_GROUP | WS_TABSTOP
		PRESPARAMS PP_FONTNAMESIZE "10.Helv"
		CONTROL "C~ell width/height", -1, 35, 38, 41, 15, WC_STATIC, SS_TEXT | DT_LEFT | DT_TOP | DT_WORDBREAK | DT_MNEMONIC | WS_VISIBLE
		CONTROL "", DID_CellSize, 81, 39, 42, 12, WC_SPINBUTTON, SPBS_MASTER | SPBS_READONLY | SPBS_JUSTLEFT | WS_VISIBLE | WS_TABSTOP
		PRESPARAMS PP_FONTNAMESIZE "10.Helv"
		DEFPUSHBUTTON "~OK", DID_OK, 69, 4, 34, 14, BS_PUSHBUTTON | BS_DEFAULT | WS_VISIBLE | WS_GROUP | WS_TABSTOP
		PUSHBUTTON "~Cancel", DID_CANCEL, 106, 4, 51, 14
		CONTROL "~Save options", DID_OptionsSave, 4, 5, 57, 10, WC_BUTTON, BS_AUTOCHECKBOX | WS_VISIBLE | WS_GROUP | WS_TABSTOP
	END

END




DLGTEMPLATE DLG_HiscoreDialog 
BEGIN
	DIALOG "Ribble - High-score entry", DLG_HiscoreDialog, 128, 64, 120, 87, FCF_SYSMENU | FCF_TITLEBAR
	PRESPARAMS PP_FONTNAMESIZE "12.Helv"
	BEGIN
		CONTROL "", -1, 6, 26, 110, 58, WC_STATIC, SS_GROUPBOX | DT_LEFT | DT_TOP | DT_MNEMONIC | WS_VISIBLE | WS_GROUP
		CONTROL "Your feeble score qualifies you for a place in the hi-score table.", DID_QualifyText, 13, 51, 96, 23, WC_STATIC, SS_TEXT | DT_LEFT | DT_TOP | DT_WORDBREAK | DT_MNEMONIC | WS_VISIBLE | WS_GROUP
		CONTROL "Ribble", DID_ScoreName, 13, 34, 96, 10, WC_ENTRYFIELD, ES_CENTER | ES_AUTOSCROLL | ES_MARGIN |  WS_VISIBLE | WS_GROUP | WS_TABSTOP
		DEFPUSHBUTTON "Record it", DID_OK, 40, 6, 41, 14
		CONTROL "Your pathetic attempt doesn't even qualify you for a position in the hi-score table.", DID_BerateText, 13, 35, 95, 31, WC_STATIC, SS_TEXT | DT_CENTER | DT_TOP | DT_WORDBREAK | DT_MNEMONIC | NOT WS_VISIBLE | WS_GROUP
	END

END

