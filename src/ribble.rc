MENU IDM_MainMenu
BEGIN

  SUBMENU "~Game", IDM_GameMenu
  BEGIN
    MENUITEM "~New Game\tCtrl+N",    IDM_GameStart
    MENUITEM "~End Game\tCtrl+Q",    IDM_GameAbandon
    MENUITEM SEPARATOR
    MENUITEM "~Open...\tCtrl+O",     IDM_GameOpen
    MENUITEM "~Save...\tCtrl+S",     IDM_GameSave
    MENUITEM SEPARATOR
    MENUITEM "~Map...\tCtrl+M",      IDM_ViewMap
    MENUITEM "~Status...\tCtrl+T",   IDM_ViewStatus
    MENUITEM SEPARATOR
    MENUITEM "E~xit\tCtrl+X",        IDM_GameExit
  END

  SUBMENU "~Options",           IDM_OptionsMenu
  BEGIN
    SUBMENU "Map ~Editor",      IDM_EditMenu
    BEGIN
      MENUITEM "~Level...",  IDM_EditLevel
      MENUITEM SEPARATOR
      MENUITEM "~Options...",  IDM_EditOptions
    END
    MENUITEM SEPARATOR
    MENUITEM "~Settings...",    IDM_Settings
    MENUITEM "~Key Mapping...", IDM_KeyMap
    MENUITEM SEPARATOR
    SUBMENU "~Language",        IDM_LangMenu
    BEGIN
      MENUITEM "E~nglish",      IDM_LANG_EN
      MENUITEM "Espan~ol",      IDM_LANG_ES
      MENUITEM "Ned~erlands",   IDM_LANG_NL
      MENUITEM "Deu~tsch",      IDM_LANG_DE
      MENUITEM "Fran~cais",     IDM_LANG_FR
      MENUITEM "Ita~liano",     IDM_LANG_IT
    END
    MENUITEM SEPARATOR
    MENUITEM "~Frame Controls\tCtrl+F",  IDM_FrameControl
    MENUITEM "~Save settings on exit", IDM_SaveOptions
  END

  SUBMENU "~Help", IDM_HelpMenu
  BEGIN
    MENUITEM "~Help for help...\tShift+F10",  IDM_HelpUsing
    MENUITEM "~Extended help...\tF2",         IDM_HelpGeneral
    MENUITEM "~Keys help...\tF9",             IDM_HelpKeys
    MENUITEM "Help ~index...\tF11",           IDM_HelpIndex
    MENUITEM SEPARATOR
    MENUITEM "~About...",                 IDM_About
  END

END

