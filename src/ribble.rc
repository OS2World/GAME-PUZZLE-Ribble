DLGTEMPLATE DLG_ProductInfo
BEGIN
	DIALOG "About Ribble", DLG_ProductInfo, 128, 130, 320, 170, , FCF_TITLEBAR | FCF_DLGBORDER
	PRESPARAMS PP_FONTNAMESIZE "8.Helv"
	BEGIN
		CTEXT "Ribble for OS/2", -1, 10, 152, 300, 10
		CTEXT "Version 1.2", -1, 10, 139, 300, 8
		CTEXT "OpenWatcom Release", -1, 10, 126, 300, 8
		CTEXT "(c) 1993, 1994, J. R. Shannon, and D. J. Neades", -1, 10, 113, 300, 8
		CTEXT "(c) 2026, OS2World", -1, 10, 100, 300, 8
		CTEXT "GNU General Public License V3", -1, 10, 87, 300, 8
		CONTROL "The animated Ribble", DID_AboutButtonGroup, 8, 10, 150, 66, WC_STATIC, SS_GROUPBOX | DT_LEFT | DT_TOP | DT_MNEMONIC | WS_VISIBLE | WS_GROUP
		DEFPUSHBUTTON "Close" DID_OK, 84, 12, 56, 14, WS_GROUP
	END

END



DLGTEMPLATE DLG_SelectLevel 
BEGIN
	DIALOG "Ribble - Level selection", DLG_SelectLevel, 128, 64, 307, 121, WS_VISIBLE, FCF_SYSMENU | FCF_TITLEBAR
