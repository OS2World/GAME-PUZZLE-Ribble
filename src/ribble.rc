BEGIN
    DIALOG "Key Mapping", IDD_KEY_MAPPING, 30, 20, 252, 196, WS_VISIBLE | WS_SAVEBITS, FCF_TITLEBAR | FCF_DLGBORDER
            PRESPARAMS PP_FONTNAMESIZE, "8.Helv"
